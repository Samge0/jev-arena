# Jev Arena configuration. Copy to .env and fill in. Never commit .env.

# --- Cloud engine: TypeSafe Jev API (required for the "jev" engine) ---
TYPESAFE_API_KEY=apikey_xxx

# Optional overrides (defaults shown):
#TYPESAFE_MODEL=jev-latest
#TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# --- Local engine: NanoJev repo (REQUIRED, no default) ---
# Clone of https://github.com/TianyuCodings/NanoJev with .venv created and
# checkpoints/NanoJev downloaded. Windows example: F:\Space\PRO\test\nanojev
NANOJEV_HOME=

#NANOJEV_CKPT=            # default: <NANOJEV_HOME>/checkpoints/NanoJev
#NANOJEV_SCRIPTS=         # default: <NANOJEV_HOME>/NanoJev/scripts
#NANOJEV_MAX_LENGTH=1024

# --- Local engine: laya venv (REQUIRED, no default) ---
# Repo containing .venv-laya with the `laya` package installed.
# Windows example: F:\Space\PRO\test\jevshoot
JEVSHOOT_HOME=
#LAYA_MODEL_ID=convaiinnovations/laya

# --- Replay site / tooling (defaults shown) ---
#ARENA_PORT=8775
#HF_ENDPOINT=https://hf-mirror.com
#HF_HUB_OFFLINE=1
